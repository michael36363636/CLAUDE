[Unit]
Description=Retrieve config from out-of-sync FortiGates via FortiManager API (manual run)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/fmg-retrieve-oos/fmg.env
ExecStart=/opt/fmg-retrieve-oos/scripts/fmg_retrieve_oos.py \
    --host ${FMG_HOST} \
    --adom ${FMG_ADOM} \
    --user ${FMG_USER} \
    --password-file /etc/fmg-retrieve-oos/fmg.passwd \
    --log-dir /var/log/fmg-retrieve-oos \
    --trigger manual
User=fmg-retrieve
Group=fmg-retrieve
